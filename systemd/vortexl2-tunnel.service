[Unit]
Description=VortexL2 L2TPv3 Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/vortexl2
Environment=PYTHONPATH=/opt/vortexl2
ExecStart=/usr/bin/python3 -m vortexl2.main apply
ExecStop=/bin/true
# BUG FIX #20: oneshot services should NOT have Restart=always —
# they run once to completion. Using Restart caused systemd to re-run
# `apply` repeatedly on any failure code, possibly duplicating tunnel entries.
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vortexl2-tunnel

[Install]
WantedBy=multi-user.target
